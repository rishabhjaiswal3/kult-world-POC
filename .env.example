NODE_ENV=development
PORT=8060
PUBLIC_ORIGIN=http://localhost:8060
TRUST_PROXY=false
KULT_REQUEST_LOGS=false
KULT_REQUEST_TIMEOUT_MS=30000

# Persistence: JSON is local/dev only. Production defaults to SQLite.
KULT_PERSISTENCE=json
KULT_DATA_FILE=./data/kult-world.json
KULT_DATA_DB=./data/kult-world.sqlite
KULT_ALLOW_JSON_PRODUCTION=false

# Session / identity
KULT_SECURE_COOKIE=false
KULT_IDENTITY_GATEWAY_SECRET=
KULT_IDENTITY_MAX_SKEW_MS=90000

# Bounded World simulation
KULT_STEP_MINUTES=60
KULT_MAX_CATCHUP_STEPS=12

# Optional 0G World decision layer
KULT_0G_ENABLED=false
KULT_0G_COMPUTE_ENDPOINT=
KULT_0G_API_KEY=
KULT_0G_TIMEOUT_MS=2500

# KULT Perp Wars
# sim = zero-credential local end-to-end game
# agent-kit = official OKX Agent Trade Kit CLI + OKX Demo Trading
KULT_MARKET_ADAPTER=sim
KULT_MARKET_ACCESS=disabled
OKX_AGENT_KIT_BIN=okx
OKX_AGENT_KIT_PROFILE=
OKX_AGENT_KIT_TIMEOUT_MS=15000
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=


# Pulse District — server-owned simulation in v6.5.
# The reference adapter is isolated from the OKX execution adapter.
# Keep sim until a reviewed BNB venue/data adapter is implemented.
KULT_PULSE_REFERENCE_ADAPTER=sim
KULT_PULSE_ACCELERATED=false
KULT_PULSE_ACCELERATED_BASE_MS=10000

# Perp Wars WAIT observation acceleration is TEST ONLY.
KULT_WAIT_ACCELERATED=false
KULT_WAIT_ACCELERATED_MS=12000
# Never enable acceleration on a public production deployment.
KULT_ALLOW_TEST_ACCELERATION=false


# Real A2A marketplace — authoritative Agent-to-Agent job/payment rail.
# Production should use external or disabled; the legacy sim mode is development only.
KULT_A2A_MODE=external
KULT_A2A_API_URL=https://a2a-api.example.com
KULT_A2A_CHAIN_API_URL=https://a2a-chain.example.com
KULT_A2A_MARKETPLACE_URL=https://app.example.com/marketplace/a2a
KULT_A2A_TIMEOUT_MS=10000
# Optional service-to-service bearer. If omitted, the bridge can forward Authorization only when explicitly enabled.
KULT_A2A_SERVICE_BEARER=
KULT_A2A_FORWARD_AUTHORIZATION=false
KULT_A2A_FORWARD_COOKIE=false
# Defaults are the deployed Base mainnet contracts from the bundled A2A repo; override only after a verified redeploy.
KULT_A2A_ESCROW_ADDRESS=0xE4F7cB9aAf7dC9f800Cb3C1ea2c26696B2CEBEa3
KULT_A2A_RECEIVER_ADDRESS=0xD1fc9b992AEa52f8d91c6B49A3FDe21Cf3Ed307E
KULT_A2A_ERC8004_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
KULT_A2A_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# X Layer: testnet (safe default) or mainnet.
# Deploy KultMarketBattleRegistry.sol to the selected network before enabling anchoring.
KULT_XLAYER_NETWORK=testnet
XLAYER_RPC_URL=https://rpc.xlayer.tech
XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon
KULT_MARKET_XLAYER_REGISTRY=

# OKX.AI
# v6.5 exposes free A2MCP-ready HTTP services under /api/okx-ai/*.
KULT_OKX_AI_NETWORK=mainnet
# Service registration and paid Agent Payments/x402 are external deployment steps;
# no payment secret is required by this release.

# Robinhood Chain proof rail used by the existing KULT Passport
# Keep false until the registry deployment and contract tests are independently verified.
KULT_PROOF_RAIL_ENABLED=false
KULT_MIN_CONFIRMATIONS=1
KULT_SEASON_PHASE=WORLD_OPEN
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
ROBINHOOD_BROWSER_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
KULT_REGISTRY_ADDRESS=
KULT_SEASON_COMMIT_TX=

# Production administration
KULT_ADMIN_TOKEN=replace-with-a-long-random-secret
