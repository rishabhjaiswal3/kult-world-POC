# KULT World v6.5.0 — production profile with real A2A bridge
# Copy to your deployment secret store/environment. Do not commit real secrets.
NODE_ENV=production
PORT=8060
PUBLIC_ORIGIN=https://world.example.com
TRUST_PROXY=false

# Persistence — single application instance only in v6.5.0.
KULT_PERSISTENCE=sqlite
KULT_DATA_DB=/var/data/kult-world.sqlite

# Market rail. Start public beta on simulator. Switch to agent-kit only after
# the OKX Demo preflight is clean and the demo profile is configured.
KULT_MARKET_ADAPTER=sim
KULT_MARKET_ACCESS=enabled
OKX_AGENT_KIT_PROFILE=

# Pulse is server-owned simulation in this release.
KULT_PULSE_REFERENCE_ADAPTER=sim
KULT_PULSE_ACCELERATED=false
KULT_WAIT_ACCELERATED=false
KULT_ALLOW_TEST_ACCELERATION=false

# Operational controls.
KULT_ADMIN_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
KULT_REQUEST_LOGS=true
KULT_REQUEST_TIMEOUT_MS=30000

# Optional identity/session hardening. Supply a strong random value in production
# if your deployment path uses signed identity/session features.
KULT_IDENTITY_GATEWAY_SECRET=


# Real A2A marketplace — authoritative Agent-to-Agent job/payment rail.
# Production should use external or disabled; the legacy sim mode is development only.
KULT_A2A_MODE=external
KULT_A2A_API_URL=https://a2a-api.example.com
KULT_A2A_CHAIN_API_URL=https://a2a-chain.example.com
KULT_A2A_MARKETPLACE_URL=https://app.example.com/marketplace/a2a
KULT_A2A_TIMEOUT_MS=10000
# Optional service-to-service bearer. If omitted, the bridge can forward Authorization only when explicitly enabled.
KULT_A2A_SERVICE_BEARER=
KULT_A2A_FORWARD_AUTHORIZATION=false
KULT_A2A_FORWARD_COOKIE=false
# Defaults are the deployed Base mainnet contracts from the bundled A2A repo; override only after a verified redeploy.
KULT_A2A_ESCROW_ADDRESS=0xE4F7cB9aAf7dC9f800Cb3C1ea2c26696B2CEBEa3
KULT_A2A_RECEIVER_ADDRESS=0xD1fc9b992AEa52f8d91c6B49A3FDe21Cf3Ed307E
KULT_A2A_ERC8004_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
KULT_A2A_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Optional X Layer receipt anchoring. Prefer testnet until separately verified.
KULT_XLAYER_NETWORK=testnet
KULT_XLAYER_REGISTRY_ADDRESS=

# Optional Passport / proof rail. Disabled in the certified public-beta scope.
# Enabling this rail requires independent contract tests + deployment verification.
KULT_PROOF_RAIL_ENABLED=false
ROBINHOOD_RPC_URL=
ROBINHOOD_BROWSER_RPC_URL=
KULT_REGISTRY_ADDRESS=
KULT_SEASON_COMMIT_TX=

# OKX.AI metadata / external discovery — no paid settlement is implied by this build.
KULT_OKX_AI_NETWORK=mainnet
